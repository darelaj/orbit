    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "31.0.0"
  }
